{
  "name": "ionic-course-site",
  "version": "1.0.0",
  "private": true,
  "description": "Site statique interactif du cours Ionic 9 \u2014 d\u00e9ployable sur GitHub Pages",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "serve": "node scripts/serve.mjs",
    "start": "node build.mjs && node scripts/serve.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:shots": "node scripts/smoke.mjs --shots",
    "deploy": "npm run build && git subtree push --prefix site origin gh-pages"
  },
  "devDependencies": {
    "markdown-it": "^14.1.0",
    "puppeteer-core": "^25.12.0"
  }
}
